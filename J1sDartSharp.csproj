<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net9.0-windows10.0.19041.0;net9.0-ios</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <RootNamespace>J1sDartSharp</RootNamespace>

    <ApplicationTitle>J1s Dart Sharp</ApplicationTitle>
    <ApplicationId>com.j1sdartsharp.app</ApplicationId>

    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <WindowsPackageType>None</WindowsPackageType>
    <MauiEnableTizen>false</MauiEnableTizen>

    <UIRequiresFullScreen>true</UIRequiresFullScreen>
    <GenerateMauiIcons>true</GenerateMauiIcons>

    <!--
      The Shared, Core, Api and Tests projects live in subfolders of this project's folder.
      Without this, the SDK's default **/*.cs (and *.razor) globs would compile
      their source into the app — including EF Core code on iOS.
      Harmless if the folders don't exist.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);J1sDartSharp.Shared\**;J1sDartSharp.Core\**;J1sDartSharp.Api\**;J1sDartSharp.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
    <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.30" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="9.0.30" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.8" />
  </ItemGroup>

  <!--
    The app talks to league data only through the Api, so it depends on
    Shared (enums, rules, DTOs) — not on Core entities or the Api project.
  -->
  <ItemGroup>
    <ProjectReference Include="J1sDartSharp.Shared\J1sDartSharp.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.png" Color="#000000" />
  </ItemGroup>

</Project>
