@using J1sDartSharp.Services

<div class="stat-grid">
    <div class="stat-item">
        <span class="stat-label">Sessions</span>
        <span class="stat-value">@Stats.SessionsPlayed</span>
    </div>
    <div class="stat-item">
        <span class="stat-label">Avg darts to double-in</span>
        <span class="stat-value">@Stats.AvgDartsToDoubleIn.ToString("F1")</span>
    </div>
    <div class="stat-item">
        <span class="stat-label">Best darts to double-in</span>
        <span class="stat-value">@Stats.BestDartsToDoubleIn</span>
    </div>
    <div class="stat-item">
        <span class="stat-label">Avg time to double-in</span>
        <span class="stat-value">@FormatDuration(Stats.AvgTimeToDoubleIn)</span>
    </div>
    <div class="stat-item">
        <span class="stat-label">Avg score / ochre</span>
        <span class="stat-value">@Stats.AvgScorePerOchre.ToString("F1")</span>
    </div>
    <div class="stat-item">
        <span class="stat-label">Best avg / ochre</span>
        <span class="stat-value">@Stats.BestScorePerOchre.ToString("F1")</span>
    </div>
    <div class="stat-item">
        <span class="stat-label">Avg time to double-out</span>
        <span class="stat-value">@FormatDuration(Stats.AvgTimeToDoubleOut)</span>
    </div>
    <div class="stat-item">
        <span class="stat-label">Best time to double-out</span>
        <span class="stat-value">@FormatDuration(Stats.BestTimeToDoubleOut)</span>
    </div>
    <div class="stat-item">
        <span class="stat-label">Avg busts</span>
        <span class="stat-value">@Stats.AvgBusts.ToString("F1")</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public X01Stats Stats { get; set; } = default!;

    private string FormatDuration(TimeSpan? ts) =>
        ts.HasValue ? $"{(int)ts.Value.TotalMinutes}m {ts.Value.Seconds}s" : "—";
}
