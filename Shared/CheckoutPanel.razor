@* CheckoutPanel.razor
   Slides in from the right whenever the remaining score is a finishable checkout (≤170).
   Shows all known routes for that score.
*@
@using J1sDartSharp.Services

@if (_suggestion is not null)
{
    <div class="checkout-panel @(_visible ? "checkout-visible" : "")">
        <div class="checkout-header">
            <span class="checkout-score">@_suggestion.Score</span>
            <span class="checkout-title">CHECKOUT</span>
            <button class="checkout-close" @onclick="() => _visible = false">✕</button>
        </div>

        <div class="checkout-routes">
            @foreach (var route in _suggestion.Routes)
            {
                <div class="checkout-route">
                    @foreach (var dart in route)
                    {
                        <span class="checkout-dart @DartClass(dart)">@dart</span>
                    }
                    @if (route.Length < 3)
                    {
                        @for (int i = route.Length; i < 3; i++)
                        {
                            <span class="checkout-dart dart-skip">—</span>
                        }
                    }
                </div>
            }
        </div>

        <div class="checkout-hint">Double out required</div>
    </div>
}

@* Trigger button shown when panel is hidden but score is finishable *@
@if (_suggestion is not null && !_visible)
{
    <button class="checkout-peek-btn" @onclick="() => _visible = true">
        🎯 @_suggestion.Score out
    </button>
}

@code {
    [Parameter] public int RemainingScore { get; set; }

    private CheckoutSuggestion? _suggestion;
    private bool _visible;

    protected override void OnParametersSet()
    {
        var prev = _suggestion?.Score;
        _suggestion = CheckoutService.GetCheckout(RemainingScore);

        // Auto-show panel whenever a new finishable score is reached
        if (_suggestion is not null && _suggestion.Score != prev)
            _visible = true;

        // Auto-hide if score is no longer finishable
        if (_suggestion is null)
            _visible = false;
    }

    private string DartClass(string dart)
    {
        if (dart.StartsWith("T")) return "dart-triple";
        if (dart.StartsWith("D")) return "dart-double";
        if (dart == "25")         return "dart-bull-single";
        return "dart-single";
    }
}
