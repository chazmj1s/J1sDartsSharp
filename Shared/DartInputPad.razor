@using J1sDartSharp.Models

<div class="dart-pad">

    <!-- ── Ochre slots ───────────────────────────────────── -->
    <div class="dart-slots">
        @for (int i = 0; i < 3; i++)
        {
            var idx  = i;
            var dart = idx < _darts.Count ? _darts[idx] : (DartThrow?)null;
            bool isNext = idx == _darts.Count;
            <div class="dart-slot @(dart.HasValue ? "filled" : "") @(isNext ? "active" : "")">
                <span class="slot-label">@(idx + 1)</span>
                @if (dart.HasValue)
                {
                    <span class="slot-val">@DartLabel(dart.Value)</span>
                }
                else
                {
                    <span class="slot-empty">—</span>
                }
            </div>
        }
        <div class="slot-total">
            @if (OchreScore > 0) { <span>@OchreScore</span> }
        </div>
    </div>

    @if (TwoColumn)
    {
        <!-- ── X01: two columns ───────────────────────────── -->
        <div class="sdt-two-col">
            <div class="sdt-col">
                @foreach (var n in NumberPad.Where(n => n >= 1 && n <= 10).OrderByDescending(n => n))
                {
                    var num = n;
                    var disabled = _darts.Count >= 3 || BlockInput;
                    <div class="sdt-row">
                        <button class="sdt-btn sdt-single" disabled="@disabled" @onclick="() => Commit(num, 1)">@num</button>
                        <button class="sdt-btn sdt-d"      disabled="@disabled" @onclick="() => Commit(num, 2)">D</button>
                        <button class="sdt-btn sdt-t"      disabled="@disabled" @onclick="() => Commit(num, 3)">T</button>
                    </div>
                }
            </div>
            <div class="sdt-col">
                @foreach (var n in NumberPad.Where(n => n >= 11 && n <= 20).OrderByDescending(n => n))
                {
                    var num = n;
                    var disabled = _darts.Count >= 3 || BlockInput;
                    <div class="sdt-row">
                        <button class="sdt-btn sdt-single" disabled="@disabled" @onclick="() => Commit(num, 1)">@num</button>
                        <button class="sdt-btn sdt-d"      disabled="@disabled" @onclick="() => Commit(num, 2)">D</button>
                        <button class="sdt-btn sdt-t"      disabled="@disabled" @onclick="() => Commit(num, 3)">T</button>
                    </div>
                }
            </div>
        </div>
        <!-- Bull + Miss on same row -->
        <div class="sdt-bull-miss-row">
            <div class="sdt-row sdt-bull-half">
                <button class="sdt-btn sdt-single" disabled="@(_darts.Count >= 3 || BlockInput)" @onclick="() => Commit(25, 1)">Bull</button>
                <button class="sdt-btn sdt-d"      disabled="@(_darts.Count >= 3 || BlockInput)" @onclick="() => Commit(25, 2)">D</button>
                <span class="sdt-spacer"></span>
            </div>
            <div class="sdt-row sdt-miss-half">
                @if (LegComplete)
                {
                    <!-- Leg finished — hide Miss/Bust, show nothing -->
                    <span class="sdt-spacer"></span>
                }
                else
                {
                    <button class="sdt-btn @(IsBust ? "sdt-bust" : "sdt-miss")"
                            disabled="@(_darts.Count >= 3 && !IsBust)"
                            @onclick="() => { if (IsBust) OnBustClicked(); else Commit(0, 1); }">
                        @(IsBust ? "Bust" : "Miss")
                    </button>
                }
            </div>
        </div>
    }
    else
    {
        <!-- ── Cricket: single column ─────────────────────── -->
        <div class="sdt-grid">
            @foreach (var n in NumberPad)
            {
                var num    = n;
                var isBull = num == 25;
                var disabled = _darts.Count >= 3;
                <div class="sdt-row">
                    <button class="sdt-btn sdt-single" disabled="@disabled" @onclick="() => Commit(num, 1)">
                        @(isBull ? "Bull" : num.ToString())
                    </button>
                    <button class="sdt-btn sdt-d" disabled="@disabled" @onclick="() => Commit(num, 2)">D</button>
                    @if (!isBull)
                    {
                        <button class="sdt-btn sdt-t" disabled="@disabled" @onclick="() => Commit(num, 3)">T</button>
                    }
                    else
                    {
                        <span class="sdt-spacer"></span>
                    }
                </div>
            }
            <!-- Miss -->
            <div class="sdt-row sdt-miss-row">
                <button class="sdt-btn sdt-miss" disabled="@(_darts.Count >= 3)" @onclick="() => Commit(0, 1)">Miss</button>
            </div>
        </div>
    }

    <!-- ── Actions ───────────────────────────────────────── -->
    <div class="pad-actions">
        <button class="btn-back" @onclick="BackDart">← Back</button>
        <button class="btn-enter @(LegComplete ? "btn-enter-finish" : "")"
                @onclick="CommitOchre"
                disabled="@(_darts.Count == 0 && !LegComplete)">
            @(LegComplete ? "✔ Finish" : $"Enter ({_darts.Count} / 3)")
        </button>
    </div>

    @if (_error is not null)
    {
        <p class="pad-error">@_error</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public int[] NumberPad { get; set; } = Array.Empty<int>();
    [Parameter] public bool TwoColumn { get; set; } = false;
    [Parameter] public int LiveRemaining { get; set; } = -1;
    [Parameter] public bool LegComplete { get; set; } = false;
    [Parameter] public EventCallback<List<DartThrow>> OnOchreCommitted { get; set; }
    [Parameter] public EventCallback<DartThrow> OnDartAdded { get; set; }
    [Parameter] public EventCallback<DartThrow> OnDartRemoved { get; set; }
    [Parameter] public EventCallback OnBust { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private List<DartThrow> _darts = new();
    private string? _error;
    private int OchreScore => _darts.Sum(d => d.Score);

    // Disable all number buttons when busted or leg complete
    private bool IsBust => LiveRemaining != -1 && (LiveRemaining < 0 || LiveRemaining == 1);
    private bool BlockInput => IsBust || LegComplete;

    private void OnBustClicked()
    {
        _darts.Clear();
        _error = null;
        OnBust.InvokeAsync();
    }

    private void Commit(int number, int multiplier)
    {
        if (_darts.Count >= 3) return;
        if (IsBust) return;
        var dart = new DartThrow(number, multiplier);
        _darts.Add(dart);
        _error = null;
        OnDartAdded.InvokeAsync(dart);
    }

    private void BackDart()
    {
        _error = null;
        if (_darts.Count > 0)
        {
            var removed = _darts[_darts.Count - 1];
            _darts.RemoveAt(_darts.Count - 1);
            OnDartRemoved.InvokeAsync(removed);
        }
        else
        {
            OnBack.InvokeAsync();
        }
    }

    private async Task CommitOchre()
    {
        if (_darts.Count == 0) return;
        var committed = new List<DartThrow>(_darts);
        _darts.Clear();
        _error = null;
        await OnOchreCommitted.InvokeAsync(committed);
    }

    private static string DartLabel(DartThrow d)
    {
        var n = d.Number == 0 ? "Miss" : d.Number == 25 ? "Bull" : d.Number.ToString();
        return d.Multiplier switch { 2 => $"D{n}", 3 => $"T{n}", _ => n };
    }
}
